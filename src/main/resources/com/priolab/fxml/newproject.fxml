<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.priolab.controller.NewProjectController"
      spacing="16" styleClass="wizard">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="New Project" styleClass="title"/>
    <Label styleClass="subtitle" wrapText="true"
           text="A project is stored as a SQLite file. Give it a name and choose where to save it."/>

    <Label text="Project name"/>
    <TextField fx:id="nameField" promptText="e.g. Q3 Roadmap"/>

    <Label text="File location"/>
    <HBox spacing="8">
        <TextField fx:id="fileField" HBox.hgrow="ALWAYS" promptText="/path/to/project.sqlite3"/>
        <Button text="Browse…" onAction="#onBrowse"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="8">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#onCancel"/>
        <Button text="Create" defaultButton="true" onAction="#onCreate" styleClass="primary"/>
    </HBox>
</VBox>
