<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.priolab.controller.DocumentController"
      spacing="8" styleClass="document">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label fx:id="nameLabel" styleClass="section-title"/>
    <Label styleClass="subtitle" wrapText="true"
           text="Pick the connector for this project from the selector in the toolbar, then use the ⚙ button to configure its settings."/>

    <Label fx:id="connectorLabel" styleClass="subtitle"/>
</VBox>
