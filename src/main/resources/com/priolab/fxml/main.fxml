<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.priolab.controller.MainController"
            styleClass="main">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <MenuBar fx:id="menuBar" minWidth="-Infinity">
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem text="New Project…" onAction="#onNewProject"/>
                            <MenuItem text="Open…" onAction="#onOpen"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Exit" onAction="#onExit"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="About" onAction="#onAbout"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox fx:id="connectorBar" alignment="CENTER_LEFT" spacing="6"
                  styleClass="connector-bar" disable="true">
                <padding>
                    <Insets top="0" right="10" bottom="0" left="10"/>
                </padding>
                <Label text="Connector:"/>
                <ComboBox fx:id="connectorCombo" prefWidth="200" minWidth="60"/>
                <Button fx:id="connectorSettingsButton" minWidth="-Infinity"
                        onAction="#onConnectorSettings" styleClass="icon-button">
                    <graphic>
                        <ImageView fx:id="connectorSettingsIcon" preserveRatio="true">
                            <image>
                                <Image url="@../img/gear.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="loadButton" text="Load" minWidth="-Infinity"
                        onAction="#onConnectorLoad">
                    <graphic>
                        <ImageView fx:id="loadIcon" preserveRatio="true">
                            <image>
                                <Image url="@../img/load.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Load the items from the connector (operation=load)"/>
                    </tooltip>
                </Button>
                <Button fx:id="saveButton" text="Save" minWidth="-Infinity"
                        onAction="#onConnectorSave">
                    <graphic>
                        <ImageView fx:id="saveIcon" preserveRatio="true">
                            <image>
                                <Image url="@../img/save.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Save the items back through the connector (operation=save)"/>
                    </tooltip>
                </Button>
                <ProgressIndicator fx:id="connectorProgress" prefWidth="20" prefHeight="20"
                                   visible="false" managed="false"/>
            </HBox>

            <Separator orientation="VERTICAL"/>

            <HBox fx:id="exporterBar" alignment="CENTER_LEFT" spacing="6"
                  styleClass="connector-bar" disable="true">
                <padding>
                    <Insets top="0" right="10" bottom="0" left="10"/>
                </padding>
                <Label text="Exporter:"/>
                <ComboBox fx:id="exporterCombo" prefWidth="200" minWidth="60"/>
                <Button fx:id="exporterSettingsButton" minWidth="-Infinity"
                        onAction="#onExporterSettings" styleClass="icon-button">
                    <graphic>
                        <ImageView fx:id="exporterSettingsIcon" preserveRatio="true">
                            <image>
                                <Image url="@../img/gear.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="exportButton" text="Export" minWidth="-Infinity"
                        onAction="#onExport">
                    <graphic>
                        <ImageView fx:id="exportIcon" preserveRatio="true">
                            <image>
                                <Image url="@../img/document.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Produce a file from the items with the exporter — nothing comes back"/>
                    </tooltip>
                </Button>
                <ProgressIndicator fx:id="exportProgress" prefWidth="20" prefHeight="20"
                                   visible="false" managed="false"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.62" styleClass="main-split">
            <items>
                <StackPane fx:id="contentPane" styleClass="content">
                    <Label text="No project open. Use File ▸ New Project… or File ▸ Open…"
                           styleClass="placeholder"/>
                </StackPane>

                <BorderPane styleClass="console">
                    <top>
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="console-header">
                            <padding>
                                <Insets top="6" right="8" bottom="6" left="10"/>
                            </padding>
                            <Label text="Console" styleClass="console-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Clear" onAction="#onClearLog"/>
                        </HBox>
                    </top>
                    <center>
                        <TextArea fx:id="logArea" editable="false" wrapText="true"
                                  styleClass="log"/>
                    </center>
                </BorderPane>
            </items>
        </SplitPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel" text="Ready" styleClass="status">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
