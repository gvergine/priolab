<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.priolab.controller.MainController"
            styleClass="main">
    <top>
        <MenuBar>
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem text="New Project…" onAction="#onNewProject"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Open…" onAction="#onOpen"/>
                        <MenuItem text="Save…" onAction="#onSave"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Exit" onAction="#onExit"/>
                    </items>
                </Menu>
                <Menu text="Help">
                    <items>
                        <MenuItem text="About" onAction="#onAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <StackPane styleClass="content">
            <Label text="No workspace open. Use File ▸ Open… to load a .sqlite3 file."
                   styleClass="placeholder"/>
        </StackPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel" text="Ready" styleClass="status">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
