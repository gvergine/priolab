<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.priolab.controller.ConnectorSettingsController"
            styleClass="dialog">
    <top>
        <VBox spacing="4">
            <padding>
                <Insets top="20" right="24" bottom="8" left="24"/>
            </padding>
            <Label fx:id="headerLabel" styleClass="section-title"/>
            <Label styleClass="subtitle" wrapText="true"
                   text="Assign values to this connector's settings. They are saved into the project file."/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="settings-scroll">
            <content>
                <VBox fx:id="keysBox" spacing="10">
                    <padding>
                        <Insets top="8" right="24" bottom="8" left="24"/>
                    </padding>
                    <Label fx:id="emptyHint" styleClass="placeholder" wrapText="true"
                           text="This connector declares no settings." visible="false" managed="false"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="12" right="24" bottom="20" left="24"/>
            </padding>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cancel" onAction="#onCancel"/>
            <Button text="OK" defaultButton="true" onAction="#onOk"/>
        </HBox>
    </bottom>
</BorderPane>
